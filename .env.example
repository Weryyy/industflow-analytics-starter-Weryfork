# Copy to .env (or export) to override defaults. All optional.

# --- Data ---
MONGO_URI=mongodb://localhost:27017/mip

# --- LLM (Ollama, local) ---
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=qwen3:14b-q4_K_M
EMBED_MODEL=bge-m3:latest
LLM_TEMPERATURE=0.1

# Language of generated reports/answers: en | es
REPORT_LANG=en

# --- Safety / sandbox ---
MAX_AGGREGATE_RESULTS=200
AGGREGATE_TIMEOUT_MS=5000

# --- Baseline windows (days) ---
SHIFT_BASELINE_DAYS=7
TREND_BASELINE_DAYS=30
